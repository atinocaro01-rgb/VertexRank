{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://www.subora.com.ng/#organization","name":"Subora","url":"https://www.subora.com.ng/","logo":"https://www.subora.com.ng/logo.png","description":"Subora is a Nigerian marketplace for shared subscriptions, online courses, software seats and digital goods, with escrow on every order.","areaServed":"NG","contactPoint":{"@type":"ContactPoint","contactType":"customer support","areaServed":"NG","availableLanguage":"English","email":"support@subora.com.ng","hoursAvailable":{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"opens":"08:00","closes":"22:00"}}},{"@type":"WebSite","@id":"https://www.subora.com.ng/#website","url":"https://www.subora.com.ng/","name":"Subora","publisher":{"@id":"https://www.subora.com.ng/#organization"},"inLanguage":"en-NG"},{"@type":"FAQPage","@id":"https://www.subora.com.ng/faq#page","url":"https://www.subora.com.ng/faq","name":"Frequently asked questions","description":"Answers to common questions about buying, funding your wallet, getting codes, refunds, disputes, account security and selling on Subora.","inLanguage":"en-NG","isPartOf":{"@id":"https://www.subora.com.ng/#website"},"about":{"@id":"https://www.subora.com.ng/#organization"},"mainEntity":[{"@type":"Question","name":"Is it safe to pay?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every payment is held in escrow. You confirm that your login, code or link works before the vendor is paid. If something breaks, you can report it and get a full or prorated refund."}},{"@type":"Question","name":"How do I get my login or code?","acceptedAnswer":{"@type":"Answer","text":"On your subscription card, usually within seconds. For many listings, sign-in codes and links are delivered automatically, so you never wait for the vendor."}},{"@type":"Question","name":"Who sells on Subora?","acceptedAnswer":{"@type":"Answer","text":"A small number of vendors approved by hand after identity checks. Subora also sells its own official listings."}},{"@type":"Question","name":"What does it cost?","acceptedAnswer":{"@type":"Answer","text":"Buying is free. You only pay the listing price from your wallet. Vendors pay a 10% fee on each sale."}},{"@type":"Question","name":"What if the vendor does not reply?","acceptedAnswer":{"@type":"Answer","text":"Tap Nudge vendor and they are alerted by SMS and email. If they still do not reply, Subora support steps in."}},{"@type":"Question","name":"Can I delete my chats or payment history?","acceptedAnswer":{"@type":"Answer","text":"No. Chats, payments and disputes are kept as permanent records so that any problem can be traced and settled fairly."}},{"@type":"Question","name":"How do I buy?","acceptedAnswer":{"@type":"Answer","text":"Fund your wallet, open a listing, pick the plan length, tick that you have read the terms, and pay. Your access appears on your subscription card or order."}},{"@type":"Question","name":"What is escrow?","acceptedAnswer":{"@type":"Answer","text":"Your money is held by Subora until you confirm that access works, or 48 hours pass with no problem reported. Only then is the vendor paid."}},{"@type":"Question","name":"Can I buy 3 or 6 months at once?","acceptedAnswer":{"@type":"Answer","text":"Yes, on most subscriptions. Longer plans cost less per month."}},{"@type":"Question","name":"How do I fund my wallet?","acceptedAnswer":{"@type":"Answer","text":"Tap Fund wallet and pay by card, bank transfer or USSD. Your wallet is credited when the payment is confirmed."}},{"@type":"Question","name":"Why can’t I pay a vendor directly?","acceptedAnswer":{"@type":"Answer","text":"Payments outside Subora have no escrow, no refunds and no dispute help. Chat messages that ask for outside payment are hidden and reviewed."}},{"@type":"Question","name":"How do coupons work?","acceptedAnswer":{"@type":"Answer","text":"Enter the code in your cart. Vendor codes only work on that vendor’s listings."}},{"@type":"Question","name":"How do I get a sign-in code?","acceptedAnswer":{"@type":"Answer","text":"Sign in with the email on your subscription card, then tap Get sign-in code. The code arrives in seconds and works once."}},{"@type":"Question","name":"The code didn’t come","acceptedAnswer":{"@type":"Answer","text":"Wait two minutes and try again. If nothing arrives, the vendor is alerted automatically. You can also message them from the card."}},{"@type":"Question","name":"A gift card says it was already used","acceptedAnswer":{"@type":"Answer","text":"Report it from the order within 30 minutes of revealing it, with a screenshot of the error. The vendor has 2 hours to send a new card or refund you, then Subora decides using the reveal log."}},{"@type":"Question","name":"How is crypto delivered?","acceptedAnswer":{"@type":"Answer","text":"You enter your own wallet address before paying. The vendor sends on-chain and adds the transaction ID. Payment is released only after the network confirms it."}},{"@type":"Question","name":"My OTP number got no SMS","acceptedAnswer":{"@type":"Answer","text":"If no SMS arrives within 20 minutes, your money goes back to your wallet automatically."}},{"@type":"Question","name":"How are these sellers checked?","acceptedAnswer":{"@type":"Answer","text":"They pass identity verification, a video selfie and a proof of address, and pay a security deposit. Confirmed claims give them strikes. 3 strikes pause them, 5 suspend them."}},{"@type":"Question","name":"When is support available?","acceptedAnswer":{"@type":"Answer","text":"Chat support answers every day from 8am to 10pm (West Africa Time). Outside those hours, leave a message and we reply first thing."}},{"@type":"Question","name":"How fast will I get a reply?","acceptedAnswer":{"@type":"Answer","text":"Chat: usually within 15 minutes in support hours. Email: within 24 hours. Disputes are decided within 48 hours of both sides sharing their evidence."}},{"@type":"Question","name":"The vendor is not replying","acceptedAnswer":{"@type":"Answer","text":"Tap Nudge vendor in the chat. The vendor gets an SMS and email. If there is no reply in the time they set (1 to 8 hours), Subora support steps in."}},{"@type":"Question","name":"I am a brand or rights holder","acceptedAnswer":{"@type":"Answer","text":"Use the Rights holder notice link in the footer. The listing is paused while we check."}},{"@type":"Question","name":"How do I get a refund?","acceptedAnswer":{"@type":"Answer","text":"Tap Report a problem on the subscription card. The vendor has 48 hours to respond. If you disagree, Subora decides using the full record."}},{"@type":"Question","name":"Are refunds prorated?","acceptedAnswer":{"@type":"Answer","text":"Vendors can refund in full, for the days left, or a custom amount. Every refund is recorded in both wallets."}},{"@type":"Question","name":"How do I turn on two-step verification?","acceptedAnswer":{"@type":"Answer","text":"Go to My profile, then Security. With it on, logging in on a new device, withdrawing and changing bank details need a code sent to your phone."}},{"@type":"Question","name":"I think someone else logged in","acceptedAnswer":{"@type":"Answer","text":"Open My profile, log out all other devices and change your password. Then message support."}},{"@type":"Question","name":"Who can sell?","acceptedAnswer":{"@type":"Answer","text":"Vendors apply and are approved by hand. Verified vendors unlock Pro tools. Gift card, crypto and account sellers need asset seller status."}},{"@type":"Question","name":"What does it cost?","acceptedAnswer":{"@type":"Answer","text":"10% of each sale, a flat ₦100 per withdrawal and a monthly marketing levy. See the Terms."}}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.subora.com.ng/"},{"@type":"ListItem","position":2,"name":"Frequently asked questions","item":"https://www.subora.com.ng/faq"}]}]}